version: "3.9"

volumes:
  mirror-data:
    driver: local
    driver_opts:
      o: bind
      type: none
      device: {{ deploy_path }}/mirror

  postgres-data:

services:

  postgres:
    image: postgres:16
    restart: unless-stopped
    environment:
      POSTGRES_DB: {{ postgres_db }}
      POSTGRES_USER: {{ postgres_user }}
      POSTGRES_PASSWORD: {{ postgres_password }}
    volumes:
      - postgres-data:/var/lib/postgresql/data

  api:
    build:
      context: ./api
    restart: unless-stopped
    depends_on:
      - postgres
    ports:
      - "8000:8000"
    environment:
      DATABASE_URL: postgresql+psycopg2://{{ postgres_user }}:{{ postgres_password }}@postgres:5432/{{ postgres_db }}

  http-server:
    build:
      context: ./hosting/http
    ports:
      - "{{ http_mirror_port }}:80"
    volumes:
      - mirror-data:/mnt/mirror

  custom-server:
    build:
      context: ./hosting/mirror-server
    ports:
      - "{{ custom_mirror_port }}:1674"
    volumes:
      - mirror-data:/mnt/mirror
    environment:
      WCR_DIR: /mnt/mirror